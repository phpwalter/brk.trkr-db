\set ON_ERROR_STOP on
\set VERBOSITY verbose

\echo '[CHECK] Critical query-plan contract'
\echo 'Run this against a production-equivalent PostgreSQL database using a deployment/read-capable role.'

BEGIN;
SET LOCAL enable_seqscan = off;
SET LOCAL enable_bitmapscan = on;
SET LOCAL plan_cache_mode = force_custom_plan;

DO $$
DECLARE
    v record;
    v_plan json;
BEGIN
    FOR v IN
        SELECT *
          FROM (VALUES
            (
              'active session lookup',
              'ix_user_sessions_active',
              $q$SELECT * FROM identity.user_sessions
                  WHERE user_id = '00000000-0000-0000-0000-000000000001'::uuid
                    AND revoked_at IS NULL
                  ORDER BY expires_at
                  LIMIT 1$q$
            ),
            (
              'owner collection browse',
              'ix_collection_entries_owner',
              $q$SELECT * FROM collection.entries
                  WHERE owner_id = '00000000-0000-0000-0000-000000000001'::uuid
                  ORDER BY status
                  LIMIT 25$q$
            ),
            (
              'wishlist browse',
              'ix_wishlist_entries_wishlist',
              $q$SELECT * FROM wanted.wishlist_entries
                  WHERE wishlist_id = '00000000-0000-0000-0000-000000000001'::uuid
                  ORDER BY status
                  LIMIT 25$q$
            ),
            (
              'latest MOC revision',
              'ix_moc_revisions_moc',
              $q$SELECT * FROM moc.revisions
                  WHERE moc_id = '00000000-0000-0000-0000-000000000001'::uuid
                  ORDER BY revision_number DESC
                  LIMIT 1$q$
            ),
            (
              'account ledger history',
              'ix_finance_ledger_account',
              $q$SELECT * FROM finance.ledger_entries
                  WHERE financial_account_id = '00000000-0000-0000-0000-000000000001'::uuid
                  ORDER BY created_at DESC
                  LIMIT 25$q$
            ),
            (
              'entity audit history',
              'ix_audit_events_entity',
              $q$SELECT * FROM audit.events
                  WHERE entity_schema = 'collection'
                    AND entity_table = 'entries'
                    AND entity_id = '00000000-0000-0000-0000-000000000001'
                  LIMIT 25$q$
            ),
            (
              'queued job dispatch',
              'ix_operations_jobs_dispatch',
              $q$SELECT * FROM operations.jobs
                  WHERE status = 'QUEUED'
                  ORDER BY priority DESC, available_at, created_at
                  LIMIT 1$q$
            )
          ) AS q(purpose, expected_index, sql_text)
    LOOP
        EXECUTE 'EXPLAIN (FORMAT JSON, COSTS OFF) ' || v.sql_text INTO v_plan;

        IF position(v.expected_index IN v_plan::text) = 0 THEN
            RAISE EXCEPTION
                'Query-plan contract failed for "%": expected index %, plan=%',
                v.purpose, v.expected_index, v_plan;
        END IF;

        RAISE NOTICE '[PASS] % -> %', v.purpose, v.expected_index;
    END LOOP;
END;
$$;

ROLLBACK;

\echo '[PASS] Critical query-plan contract verified.'
