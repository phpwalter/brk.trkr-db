\set ON_ERROR_STOP on
\set QUIET 1

\echo '==============================================================================='
\echo ' BrickTrackr PgBouncer transaction-context verification'
\echo ' IMPORTANT: run this using the SAME PgBouncer endpoint and runtime DB role'
\echo ' used by the API middleware. PgBouncer must be configured for transaction mode.'
\echo '==============================================================================='

\set user_a '00000000-0000-7000-8000-0000000000a1'
\set user_b '00000000-0000-7000-8000-0000000000b2'
\set request_a '00000000-0000-7000-8000-0000000000c1'
\set request_b '00000000-0000-7000-8000-0000000000c2'

/* Baseline: no pooled request identity may already be present. */
SELECT NULLIF(pg_catalog.current_setting('app.current_user_id', true), '') IS NULL AS bt_ok \gset
\if :bt_ok
\else
    \echo '[FAIL] Pooled connection arrived with leaked app.current_user_id'
    \quit 3
\endif

/*
 * Calling the identity setter outside explicit BEGIN executes in an implicit
 * one-statement transaction. Its transaction-local value must disappear before
 * the next statement. This is fail-closed behavior if middleware forgets BEGIN.
 */
SELECT app.set_authenticated_user(:'user_a'::uuid);
SELECT NULLIF(pg_catalog.current_setting('app.current_user_id', true), '') IS NULL AS bt_ok \gset
\if :bt_ok
\else
    \echo '[FAIL] Identity persisted after implicit statement transaction'
    \quit 3
\endif

/* Explicit transaction: identity/context are visible only inside the request. */
BEGIN;
SELECT app.set_authenticated_user(:'user_a'::uuid);
SELECT app.set_request_context(:'request_a'::uuid, 'pgbouncer-commit-a', 'USER');

SELECT (
    pg_catalog.current_setting('app.current_user_id', true) = :'user_a'
    AND pg_catalog.current_setting('app.request_id', true) = :'request_a'
    AND pg_catalog.current_setting('app.trace_id', true) = 'pgbouncer-commit-a'
    AND pg_catalog.current_setting('app.actor_class', true) = 'USER'
) AS bt_ok \gset
\if :bt_ok
\else
    \echo '[FAIL] Request A context is not visible inside its transaction'
    ROLLBACK;
    \quit 3
\endif
COMMIT;

/* COMMIT must return a clean logical request context to the pool. */
SELECT (
    NULLIF(pg_catalog.current_setting('app.current_user_id', true), '') IS NULL
    AND NULLIF(pg_catalog.current_setting('app.request_id', true), '') IS NULL
    AND NULLIF(pg_catalog.current_setting('app.trace_id', true), '') IS NULL
    AND NULLIF(pg_catalog.current_setting('app.actor_class', true), '') IS NULL
) AS bt_ok \gset
\if :bt_ok
\else
    \echo '[FAIL] Request context leaked across COMMIT / pool boundary'
    \quit 3
\endif

/* ROLLBACK must also remove all transaction-local context. */
BEGIN;
SELECT app.set_authenticated_user(:'user_b'::uuid);
SELECT app.set_request_context(:'request_b'::uuid, 'pgbouncer-rollback-b', 'USER');

SELECT (
    pg_catalog.current_setting('app.current_user_id', true) = :'user_b'
    AND pg_catalog.current_setting('app.request_id', true) = :'request_b'
) AS bt_ok \gset
\if :bt_ok
\else
    \echo '[FAIL] Request B context is not visible inside rollback transaction'
    ROLLBACK;
    \quit 3
\endif
ROLLBACK;

SELECT (
    NULLIF(pg_catalog.current_setting('app.current_user_id', true), '') IS NULL
    AND NULLIF(pg_catalog.current_setting('app.request_id', true), '') IS NULL
    AND NULLIF(pg_catalog.current_setting('app.trace_id', true), '') IS NULL
    AND NULLIF(pg_catalog.current_setting('app.actor_class', true), '') IS NULL
) AS bt_ok \gset
\if :bt_ok
\else
    \echo '[FAIL] Request context leaked across ROLLBACK / pool boundary'
    \quit 3
\endif

/* A new request must be able to establish a different actor cleanly. */
BEGIN;
SELECT app.set_authenticated_user(:'user_b'::uuid);
SELECT pg_catalog.current_setting('app.current_user_id', true) = :'user_b' AS bt_ok \gset
\if :bt_ok
\else
    \echo '[FAIL] New pooled request did not establish User B independently'
    ROLLBACK;
    \quit 3
\endif
COMMIT;

SELECT NULLIF(pg_catalog.current_setting('app.current_user_id', true), '') IS NULL AS bt_ok \gset
\if :bt_ok
\else
    \echo '[FAIL] Final pooled connection identity is not clean'
    \quit 3
\endif

\echo '[PASS] PgBouncer transaction-context contract verified.'
